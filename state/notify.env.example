# 알림 설정 — 이 내용을 ~/.auto-improve/notify.env 로 복사해 채운다 (git 에 올리지 않는다)
# 비워 두면 그 채널은 건너뛴다. GitHub Issue 와 Windows 토스트는 설정 없이 동작한다.

# Slack incoming webhook
AIDEV_SLACK_WEBHOOK=

# 이메일 (curl SMTP). 네이버: smtps://smtp.naver.com:465, 앱 비밀번호 필요 / Gmail: smtps://smtp.gmail.com:465, 앱 비밀번호
AIDEV_SMTP_URL=
AIDEV_SMTP_USER=
AIDEV_SMTP_PASS=
AIDEV_MAIL_FROM=
AIDEV_MAIL_TO=gagagiga@naver.com
