# 서비스 실행에 필요한 환경변수는 아래 네 개뿐입니다.
# 실제 값은 .env에 저장하고 저장소에 커밋하지 마세요.
POSTGRES_DSN=postgres://madi:CHANGE_DATABASE_PASSWORD@postgres.internal:5432/madi?sslmode=verify-full
BOOTSTRAP_ADMIN=admin@example.internal
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
# 연결망에서 openssl rand -base64 32 로 생성한 값을 입력하세요.
ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
